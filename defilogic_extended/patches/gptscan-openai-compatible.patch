+def _strip_markdown_code_fence(response: str) -> str:
+    """Return JSON/text wrapped in a single Markdown fence as plain text.
+
+    GPTScan's downstream rules use ``json.loads`` on several LLM responses.
+    OpenAI-compatible providers commonly wrap otherwise-valid JSON in
+    `````json`` fences, which the original implementation did not handle.
+    """
+    text = response.strip()
+    if not text.startswith("```"):
+        return text
+    lines = text.splitlines()
+    if len(lines) >= 2 and lines[-1].strip().startswith("```"):
+        return "\n".join(lines[1:-1]).strip()
+    return text
+

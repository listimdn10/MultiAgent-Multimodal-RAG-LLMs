# Select exactly one execution backend for live experiments.
# Never commit a populated .env file.

# OpenAI-compatible backend
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mistral backend (used by the DeFiLogic-Extended reproductions)
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TIMEOUT_SECONDS=90

# Local Ollama fallback
OLLAMA_MODEL=ollama/llama3:8b-instruct-q8_0
OLLAMA_BASE_URL=http://localhost:11434

# Optional legacy RAG services; only needed by legacy RAG entry points.
GEMINI_API_KEY=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_VECTOR_INDEX=

# Optional only when refreshing VERITE contract downloads.
ETHERSCAN_API_KEY=
